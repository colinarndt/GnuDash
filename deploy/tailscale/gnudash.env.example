# /etc/gnudash/gnudash.env  (root:root, mode 600) -- read by systemd, not the app dir.

# Next.js standalone server: loopback only, `tailscale serve` is the way in.
HOSTNAME=127.0.0.1
PORT=3100
NODE_ENV=production

# The Syncthing-synced book. Set => every browser opens it read-only.
GNUDASH_BOOK_PATH=/srv/gnucash/Booksy-sql.gnucash

# Local app data (portfolios, classifications, Plaid/SnapTrade stores, caches).
PLAID_DATA_DIR=/srv/gnudash/data

# Public URL as the browser sees it (used for SnapTrade's redirect back).
APP_URL=https://optiplex.<tailnet>.ts.net:10000

# Provider keys -- copy the values from app/.env on the Mac.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
ALPHA_VANTAGE_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
RENTCAST_API_KEY=
SERP_API_KEY=
